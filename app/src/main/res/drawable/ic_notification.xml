<?xml version="1.0" encoding="utf-8"?>
<!--
    The status-bar and notification small icon: Jawon's mark.

    Media3 otherwise ships its own generic music note here, which is why Jawon's
    notification looked anonymous next to other players. The app *name* comes free — Android
    puts it in the notification header from the package — so this is the missing half.

    A separate file from `ic_launcher_monochrome`, not a reuse of it, because the two have
    different framing rules. An adaptive icon's monochrome layer is a 108dp canvas with 18dp
    of safe-zone padding on every side, since the system masks it; a notification icon is a
    24dp canvas that is *not* masked and is expected to fill its box. Pointing the
    notification at the launcher layer would draw the mark at about half the size it should
    be, floating in the middle of the status bar.

    `JawonMark.Geometry` at a width of 22, centred on (12,12), with the rim a little heavier
    than its proportion (1.6 rather than 1.2): the platform flattens this to one colour, and
    at 24dp a hairline rim is the first thing to go.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <path
        android:pathData="M12,12 m-10.1,0 a10.1,10.1 0 1,0 20.2,0 a10.1,10.1 0 1,0 -20.2,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6" />
    <path
        android:pathData="M15.74,3.4 L15.74,12 A3.74,3.74 0 0,1 9.135,14.404"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M12,12 m-1.65,0 a1.65,1.65 0 1,0 3.3,0 a1.65,1.65 0 1,0 -3.3,0"
        android:fillColor="#FFFFFF" />
</vector>
