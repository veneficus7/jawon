<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground: a disc, lit.

    The first attempt drew a disc emerging from a case edge — literal, and it read as any
    media player with a rectangle bolted on. This is the other thing a CD actually is: a
    surface of microscopic tracks that throws a hard streak of light when a lamp crosses it.
    Concentric rings and one hot amber sweep, which is exactly what the room does to the
    disc on screen.

    It also earns the animation. The rings and the sweep are separate named groups, so
    `ic_splash_disc_animated.xml` spins them up and walks the highlight round without
    redrawing any of this — the launcher icon and the splash are the same artwork.

    Geometry: 108 canvas, adaptive mask keeps only the centre ~72, and launchers may crop to
    a circle inside that. Everything sits within r=28 of centre (54,54), so no mask clips it.

    Palette is DESIGN.md's — labelCream, lampAmber, crateBlack, oxideTeal for the cool
    counter-sweep so the mark is not monochrome amber.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The disc face. Slightly off-axis gradient so it reads as a lit surface, not a coin. -->
    <path android:pathData="M54,54 m-28,0 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="28"
                android:endX="80"
                android:endY="82">
                <item android:offset="0.0" android:color="#FFF6E8" />
                <item android:offset="0.38" android:color="#E8DAC1" />
                <item android:offset="0.72" android:color="#B7A88F" />
                <item android:offset="1.0" android:color="#D8C9AE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Data tracks. Thin, low-contrast, closely spaced — texture rather than pattern. -->
    <group android:name="tracks">
        <path
            android:pathData="M54,54 m-24.5,0 a24.5,24.5 0 1,0 49,0 a24.5,24.5 0 1,0 -49,0"
            android:strokeColor="#8C7F6A" android:strokeWidth="0.7" android:strokeAlpha="0.45" />
        <path
            android:pathData="M54,54 m-21,0 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0"
            android:strokeColor="#8C7F6A" android:strokeWidth="0.7" android:strokeAlpha="0.35" />
        <path
            android:pathData="M54,54 m-17.5,0 a17.5,17.5 0 1,0 35,0 a17.5,17.5 0 1,0 -35,0"
            android:strokeColor="#8C7F6A" android:strokeWidth="0.7" android:strokeAlpha="0.28" />
        <path
            android:pathData="M54,54 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0"
            android:strokeColor="#8C7F6A" android:strokeWidth="0.7" android:strokeAlpha="0.22" />
    </group>

    <!-- The lamp's streak, and a cooler counter-sweep opposite it so the disc reads as
         sitting in a room with more than one source rather than under a spotlight. -->
    <group android:name="sweep">
        <path
            android:pathData="M59.7,32.8 A22,22 0 0,1 73.9,63.3"
            android:strokeColor="#F0A93C"
            android:strokeWidth="5.5"
            android:strokeAlpha="0.92"
            android:strokeLineCap="round" />
        <path
            android:pathData="M44.7,73.9 A22,22 0 0,1 32.1,55.9"
            android:strokeColor="#2F7D71"
            android:strokeWidth="3.5"
            android:strokeAlpha="0.55"
            android:strokeLineCap="round" />
    </group>

    <!-- Hub: the clear stacking ring, then the centre hole. -->
    <path
        android:pathData="M54,54 m-10.5,0 a10.5,10.5 0 1,0 21,0 a10.5,10.5 0 1,0 -21,0"
        android:fillColor="#F3E9D6" />
    <path
        android:pathData="M54,54 m-10.5,0 a10.5,10.5 0 1,0 21,0 a10.5,10.5 0 1,0 -21,0"
        android:strokeColor="#9C8E77" android:strokeWidth="0.8" android:strokeAlpha="0.6" />
    <path
        android:pathData="M54,54 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
        android:fillColor="#17120F" />
</vector>
