<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground: a disc easing out of a case.

    The app's whole idea in one mark — a compact disc emerging from behind the edge of its
    sleeve, which is literally what the open sequence does. A bare disc would read as any
    media player; the case edge beside it is what makes it Jawon.

    Adaptive icon geometry: the 108dp canvas is masked to the centre 72dp, and launchers may
    crop to a circle inscribed in that. Everything meaningful is kept inside roughly
    x/y 26..82 so no launcher shape can cut the disc.

    Colours are DESIGN.md's: labelCream for the disc face, lampAmber for the light catching
    its edge, crateBlack for the centre hole and the case.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The case, edge-on behind the disc: a slim slab with its lit front edge. -->
    <path
        android:pathData="M30,30 L44,30 L44,78 L30,78 Z"
        android:fillColor="#241C17" />
    <path
        android:pathData="M42.4,30 L44,30 L44,78 L42.4,78 Z"
        android:fillColor="#4A3B2C" />

    <!-- The disc, caught mid-lift and overlapping the case the way it does on screen. -->
    <path android:pathData="M60,54m-25,0a25,25 0 1,0 50,0a25,25 0 1,0 -50,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="32"
                android:endX="82"
                android:endY="76">
                <item android:offset="0.0" android:color="#FFF4E4" />
                <item android:offset="0.42" android:color="#EFE3CC" />
                <item android:offset="0.78" android:color="#C9BAA1" />
                <item android:offset="1.0" android:color="#E4D6BC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The lamp's highlight sweeping the disc's upper edge — the app's one warm accent. -->
    <path
        android:pathData="M60,29 a25,25 0 0,1 21.6,12.5 a25,25 0 0,0 -43.2,0 a25,25 0 0,1 21.6,-12.5 Z"
        android:fillColor="#F0A93C"
        android:fillAlpha="0.55" />

    <!-- Hub: the clear stacking ring, then the centre hole. -->
    <path
        android:pathData="M60,54m-9,0a9,9 0 1,0 18,0a9,9 0 1,0 -18,0"
        android:fillColor="#BFB19A" />
    <path
        android:pathData="M60,54m-5,0a5,5 0 1,0 10,0a5,5 0 1,0 -10,0"
        android:fillColor="#17120F" />
</vector>
