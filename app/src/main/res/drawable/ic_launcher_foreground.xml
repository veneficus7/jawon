<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground: Jawon's mark — a J whose hook catches a disc's centre hole — lit as
    the room's neon sign is (0.7.3).

    It replaced a hard-lit cream disc with an amber sweep, which said "a disc" and nothing
    about whose. The mark says both: the rim and the hole are the object every format shares,
    and the letter hanging from the rim is the name. It is also what every screen in the app
    now wears beside its title, so the icon on the home screen and the thing in the corner of
    Settings are visibly the same mark.

    Geometry is `JawonMark.Geometry` at a width of 60, centred on (54,54) — keep the two in
    step, the Kotlin is the source:

        rim     r = 0.46 × 60 = 27.6, stroke 0.055 × 60 = 3.3
        hole    r = 0.075 × 60 = 4.5
        J       stroke 0.10 × 60 = 6, stem at x = 54 + 0.17 × 60 = 64.2 from
                y = 54 − 0.40 × 60 = 30 down to the hole's level, then a hook of
                r = 10.2 turning 140° round the hole, ending at (46.19, 60.56)

    The rim's outside edge sits at r = 29.25 and the halo at about 32: inside the 33 an
    adaptive icon keeps under its tightest mask, so no launcher clips it.

    Lit in three passes, as a tube is: a wide faint halo, the amber stroke, and a thin warm
    core down the middle. Below ~48px the core and halo fall away into the stroke and what
    is left is the plain amber mark, which is the version that has to survive.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The glow the sign throws on the wall behind it. -->
    <path android:pathData="M54,54 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34">
                <item android:offset="0.0" android:color="#2EFFB43C" />
                <item android:offset="0.62" android:color="#1FFFB43C" />
                <item android:offset="0.84" android:color="#14FFB43C" />
                <item android:offset="1.0" android:color="#00FFB43C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Halo. -->
    <path
        android:pathData="M54,54 m-27.6,0 a27.6,27.6 0 1,0 55.2,0 a27.6,27.6 0 1,0 -55.2,0"
        android:strokeColor="#FFB43C"
        android:strokeAlpha="0.22"
        android:strokeWidth="7.5" />
    <path
        android:pathData="M64.2,30 L64.2,54 A10.2,10.2 0 0,1 46.19,60.56"
        android:strokeColor="#FFB43C"
        android:strokeAlpha="0.22"
        android:strokeWidth="11"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,54 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0"
        android:fillColor="#FFB43C"
        android:fillAlpha="0.22" />

    <!-- The mark. -->
    <path
        android:pathData="M54,54 m-27.6,0 a27.6,27.6 0 1,0 55.2,0 a27.6,27.6 0 1,0 -55.2,0"
        android:strokeColor="#FFB43C"
        android:strokeWidth="3.3" />
    <path
        android:pathData="M64.2,30 L64.2,54 A10.2,10.2 0 0,1 46.19,60.56"
        android:strokeColor="#FFB43C"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,54 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0"
        android:fillColor="#FFB43C" />

    <!-- The core, where a tube is hottest. -->
    <path
        android:pathData="M54,54 m-27.6,0 a27.6,27.6 0 1,0 55.2,0 a27.6,27.6 0 1,0 -55.2,0"
        android:strokeColor="#FFEBC7"
        android:strokeWidth="1.1" />
    <path
        android:pathData="M64.2,30 L64.2,54 A10.2,10.2 0 0,1 46.19,60.56"
        android:strokeColor="#FFEBC7"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,54 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
        android:fillColor="#FFEBC7" />
</vector>
