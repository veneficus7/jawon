<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher background: the Midnight Shop's ground, with the lamp pooling from above right.

    DESIGN.md's crateBlack (#17120F) rather than pure black, warmed toward lampAmber in the
    corner the light comes from — the same direction the room's key light sits, so the icon
    and the app agree about where the lamp is.

    Adaptive icons are masked to as little as the centre 66%, so nothing here may carry
    meaning: this is ground only, and the disc on the foreground layer does the work.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#17120F" />

    <!-- The lamp's pool, from up and to the right, matching RoomLighting.KEY_POSITION. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="74"
                android:centerY="30"
                android:gradientRadius="82">
                <item android:offset="0.0" android:color="#2E2418" />
                <item android:offset="0.55" android:color="#1D1711" />
                <item android:offset="1.0" android:color="#17120F" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
