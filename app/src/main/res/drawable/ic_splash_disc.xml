<?xml version="1.0" encoding="utf-8"?>
<!--
    The splash icon's artwork — the launcher mark, with pivots set up so it can be animated.

    Kept separate from `ic_launcher_foreground.xml` for one reason: an AnimatedVectorDrawable
    can only animate `<group>`s that carry `android:name`, and those groups need explicit
    `pivotX`/`pivotY` at the disc's centre or they rotate about the canvas origin and swing
    off screen. Adding animation scaffolding to the launcher icon would put it in the APK
    four more times for no benefit, since a launcher icon never animates.

    The art is deliberately identical, so the thing that spins up on the splash and the thing
    on the home screen are the same object. See the launcher foreground for why the face is
    split hard rather than shaded softly, and why the groove rings are gone.

    **One deliberate difference.** The launcher drops the grooves entirely; this keeps a
    single asymmetric arc, because a perfectly concentric disc rotating looks completely
    static — the spin needs something to be visibly carried round. It is stroked dark against
    the lit half rather than light against a pale one, so it survives the new contrast.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:name="disc" android:pivotX="54" android:pivotY="54">

        <path android:pathData="M54,54 m-29,0 a29,29 0 1,0 58,0 a29,29 0 1,0 -58,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="32" android:startY="29"
                    android:endX="79" android:endY="80">
                    <item android:offset="0.0" android:color="#FFFBF2" />
                    <item android:offset="0.30" android:color="#F3E7CE" />
                    <item android:offset="0.52" android:color="#8A7A61" />
                    <item android:offset="0.62" android:color="#4A3E30" />
                    <item android:offset="1.0" android:color="#2A2119" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Turns with the disc; the sweep does not, so the highlight stays put in the room
             while the surface moves under it. That is what a real lit disc does, and it is
             the whole reason these are two groups. -->
        <group android:name="tracks" android:pivotX="54" android:pivotY="54">
            <path
                android:pathData="M54,54 m-19,0 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0"
                android:strokeColor="#6B5C46" android:strokeWidth="1.2" android:strokeAlpha="0.55"
                android:trimPathStart="0.06" android:trimPathEnd="0.44" />
        </group>

        <group android:name="sweep" android:pivotX="54" android:pivotY="54">
            <path
                android:name="streak"
                android:pathData="M63.2,31.6 A24,24 0 0,1 77.4,64.8"
                android:strokeColor="#FFB43C"
                android:strokeWidth="9"
                android:strokeLineCap="round" />
            <path
                android:pathData="M43.4,76.6 A24,24 0 0,1 30.4,56.2"
                android:strokeColor="#3FA396"
                android:strokeWidth="5"
                android:strokeAlpha="0.9"
                android:strokeLineCap="round" />
        </group>

        <path
            android:pathData="M54,54 m-11.5,0 a11.5,11.5 0 1,0 23,0 a11.5,11.5 0 1,0 -23,0"
            android:fillColor="#FFF8EA" />
        <path
            android:pathData="M54,54 m-11.5,0 a11.5,11.5 0 1,0 23,0 a11.5,11.5 0 1,0 -23,0"
            android:strokeColor="#241C15" android:strokeWidth="1.2" />
        <path
            android:pathData="M54,54 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0"
            android:fillColor="#0B0907" />
    </group>
</vector>
