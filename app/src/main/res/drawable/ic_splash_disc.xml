<?xml version="1.0" encoding="utf-8"?>
<!--
    The splash icon's artwork — the launcher mark, with pivots set up so it can be animated.

    Kept separate from `ic_launcher_foreground.xml` for one reason: an AnimatedVectorDrawable
    can only animate `<group>`s that carry `android:name`, and those groups need explicit
    `pivotX`/`pivotY` at the disc's centre or they rotate about the canvas origin and swing
    off screen. Adding animation scaffolding to the launcher icon would put it in the APK
    four more times for no benefit, since a launcher icon never animates.

    The art is deliberately identical, so the thing that spins up on the splash and the thing
    on the home screen are the same object.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:name="disc" android:pivotX="54" android:pivotY="54">

        <path android:pathData="M54,54 m-28,0 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="30" android:startY="28"
                    android:endX="80" android:endY="82">
                    <item android:offset="0.0" android:color="#FFF6E8" />
                    <item android:offset="0.38" android:color="#E8DAC1" />
                    <item android:offset="0.72" android:color="#B7A88F" />
                    <item android:offset="1.0" android:color="#D8C9AE" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Tracks spin with the disc; the sweep does not, so the highlight stays put in
             the room while the surface turns under it. That is what a real lit disc does,
             and it is the whole reason these are two groups. -->
        <group android:name="tracks" android:pivotX="54" android:pivotY="54">
            <path
                android:pathData="M54,54 m-24.5,0 a24.5,24.5 0 1,0 49,0 a24.5,24.5 0 1,0 -49,0"
                android:strokeColor="#8C7F6A" android:strokeWidth="0.7" android:strokeAlpha="0.45" />
            <path
                android:pathData="M54,54 m-21,0 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0"
                android:strokeColor="#8C7F6A" android:strokeWidth="0.7" android:strokeAlpha="0.35" />
            <path
                android:pathData="M54,54 m-17.5,0 a17.5,17.5 0 1,0 35,0 a17.5,17.5 0 1,0 -35,0"
                android:strokeColor="#8C7F6A" android:strokeWidth="0.7" android:strokeAlpha="0.28" />
            <!-- One deliberately asymmetric mark so the spin is actually visible. A
                 perfectly concentric disc rotating looks completely static. -->
            <path
                android:pathData="M54,54 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0"
                android:strokeColor="#8C7F6A" android:strokeWidth="0.9" android:strokeAlpha="0.30"
                android:trimPathStart="0.05" android:trimPathEnd="0.62" />
        </group>

        <group android:name="sweep" android:pivotX="54" android:pivotY="54">
            <path
                android:name="streak"
                android:pathData="M59.7,32.8 A22,22 0 0,1 73.9,63.3"
                android:strokeColor="#F0A93C"
                android:strokeWidth="5.5"
                android:strokeAlpha="0.92"
                android:strokeLineCap="round" />
            <path
                android:pathData="M44.7,73.9 A22,22 0 0,1 32.1,55.9"
                android:strokeColor="#2F7D71"
                android:strokeWidth="3.5"
                android:strokeAlpha="0.55"
                android:strokeLineCap="round" />
        </group>

        <path
            android:pathData="M54,54 m-10.5,0 a10.5,10.5 0 1,0 21,0 a10.5,10.5 0 1,0 -21,0"
            android:fillColor="#F3E9D6" />
        <path
            android:pathData="M54,54 m-10.5,0 a10.5,10.5 0 1,0 21,0 a10.5,10.5 0 1,0 -21,0"
            android:strokeColor="#9C8E77" android:strokeWidth="0.8" android:strokeAlpha="0.6" />
        <path
            android:pathData="M54,54 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
            android:fillColor="#17120F" />
    </group>
</vector>
