<?xml version="1.0" encoding="utf-8"?>
<!--
    The animated splash icon — the disc spinning up, exactly what the app opens into.

    Wired to `windowSplashScreenAnimatedIcon` in `values-v31/themes.xml`. Android 12+ plays
    this in place of the static icon on the system splash, so it replaces the launch flash
    rather than adding a second screen after it. That is the whole reason for going the AVD
    route instead of a video: a video cannot touch the system splash, so it can only ever
    play *afterwards*, and the user sees two openings.

    Constraints the platform imposes here, all of which shaped the artwork:

    - It is masked to a circle, so nothing may rely on the corners.
    - It should finish inside a second; `windowSplashScreenAnimationDuration` is 900ms and
      these animators match it. The system does not wait for a longer animation.
    - Only `<group>`s with `android:name` can be driven, and each needs an explicit pivot at
      the disc's centre or it rotates about the canvas origin.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_splash_disc">

    <target android:name="disc" android:animation="@animator/splash_disc_in" />
    <target android:name="tracks" android:animation="@animator/splash_disc_spin" />
    <target android:name="sweep" android:animation="@animator/splash_sweep" />
</animated-vector>
