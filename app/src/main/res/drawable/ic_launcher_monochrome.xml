<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed-icon layer (Android 13+).

    The system discards these colours and tints the layer from the wallpaper palette, so
    **only alpha carries the design**. The colour mark relies on an amber streak against
    cream to read; flattened to one tint, that streak would vanish into the disc.

    So the silhouette says the same thing structurally instead: a broken ring — a disc with
    a gap where the light crosses it — and the hole knocked out by an even-odd fill. The
    weight difference between the thick sweep and the disc body survives tinting because it
    is shape, not value — and the sweep got heavier here too, for the same reason the colour
    mark did: it is the one gesture, so it should carry.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FFFFFF">

    <!-- The disc as a ring, centre hole knocked out. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,54 m-29,0 a29,29 0 1,0 58,0 a29,29 0 1,0 -58,0 M54,54 m-11.5,0 a11.5,11.5 0 1,0 23,0 a11.5,11.5 0 1,0 -23,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.34" />

    <!-- The light sweep, at full weight so it reads as the mark's one gesture. -->
    <path
        android:pathData="M63.2,31.6 A24,24 0 0,1 77.4,64.8"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />

    <!-- Centre hole, punched back out of the ring above. -->
    <path
        android:pathData="M54,54 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0" />
</vector>
