<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed-icon layer (Android 13+): Jawon's mark, flat.

    The system discards these colours and tints the layer from the wallpaper palette, so only
    alpha carries the design. The mark needs nothing else — it was drawn as a line in one
    colour from the start — so this is the foreground's middle pass alone, at full alpha:
    the rim, the hole, and the J hanging from one round the other. Same geometry as
    `ic_launcher_foreground.xml` (`JawonMark.Geometry` at a width of 60).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#FFFFFF">

    <path
        android:pathData="M54,54 m-27.6,0 a27.6,27.6 0 1,0 55.2,0 a27.6,27.6 0 1,0 -55.2,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.3" />
    <path
        android:pathData="M64.2,30 L64.2,54 A10.2,10.2 0 0,1 46.19,60.56"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,54 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0"
        android:fillColor="#FFFFFF" />
</vector>
