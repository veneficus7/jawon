<?xml version="1.0" encoding="utf-8"?>
<!--
    The record that is on, as the thing itself: a small jewel case standing on the home screen,
    with play or pause over its corner. Used when the widget is narrow.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    tools:targetApi="s">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_ground" />

    <ImageView
        android:id="@+id/widget_case"
        android:src="@drawable/ic_shortcut_record"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/widget_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:background="@drawable/widget_button_over_art"
        android:contentDescription="@string/widget_play"
        android:src="@drawable/ic_widget_play" />
</FrameLayout>
