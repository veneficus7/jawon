<?xml version="1.0" encoding="utf-8"?>
<!--
    The J, carried on from the rim: nothing until the rim closes at the top, then down the
    stem and round the hole, slowing into the end of the hook.
-->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="900">
    <propertyValuesHolder android:propertyName="trimPathEnd" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0" />
        <keyframe android:fraction="0.5" android:value="0" />
        <keyframe
            android:fraction="0.84"
            android:value="1"
            android:interpolator="@android:interpolator/decelerate_quad" />
        <keyframe android:fraction="1" android:value="1" />
    </propertyValuesHolder>
</objectAnimator>
