<?xml version="1.0" encoding="utf-8"?>
<!--
    The mark arriving: a small scale-up under the system's own icon reveal.

    Deliberately subtle. The splash icon is already masked and scaled by the platform, and a
    big scale gesture on top of that reads as two animations fighting.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:propertyName="scaleX"
        android:valueFrom="0.86" android:valueTo="1.0" android:valueType="floatType"
        android:duration="620"
        android:interpolator="@android:interpolator/decelerate_quint" />
    <objectAnimator
        android:propertyName="scaleY"
        android:valueFrom="0.86" android:valueTo="1.0" android:valueType="floatType"
        android:duration="620"
        android:interpolator="@android:interpolator/decelerate_quint" />
</set>
