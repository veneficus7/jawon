<?xml version="1.0" encoding="utf-8"?>
<!--
    The hole lighting last, as the hook comes round it — a small overshoot, the one beat in
    the splash allowed to land with a bounce.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator android:duration="900">
        <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
            <keyframe android:fraction="0" android:value="0" />
            <keyframe android:fraction="0.66" android:value="0" />
            <keyframe
                android:fraction="1"
                android:value="1"
                android:interpolator="@android:interpolator/overshoot" />
        </propertyValuesHolder>
    </objectAnimator>
    <objectAnimator android:duration="900">
        <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
            <keyframe android:fraction="0" android:value="0" />
            <keyframe android:fraction="0.66" android:value="0" />
            <keyframe
                android:fraction="1"
                android:value="1"
                android:interpolator="@android:interpolator/overshoot" />
        </propertyValuesHolder>
    </objectAnimator>
</set>
