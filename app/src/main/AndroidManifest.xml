<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        For the platter's haptics. A normal permission — granted at install, no prompt, and
        nothing to declare on Play's data safety form. See RoomHaptics for why the disc does
        not use View.performHapticFeedback: that route depends on the separate "touch
        feedback" system setting, which is off on many phones, and testers reported the disc
        had no vibration at all because of it.
    -->
    <!--
        For the equaliser. A normal permission — granted at install with no prompt — needed
        to attach an AudioEffect to the app's own playback session.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Cover art lookup, and nothing else. This is the app's only network use: an album
        title and an artist name go out for records whose own files carry no artwork, and an
        image comes back. No device id, no account, no library listing. It runs only when the
        user leaves the switch in Settings on, and the import screen says so before it happens.
        See data/importer/CoverArtFetcher.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        So Jawon can offer its own updates, instead of the owner sending an APK to everyone
        by hand every time something changes.

        This never installs anything silently, and cannot: the platform always shows its own
        install prompt, and the user has to have granted this app "install unknown apps"
        first. The real protection is the signing key — Android refuses an update signed with
        a different key than the installed app, so a tampered download can only fail, never
        replace Jawon with something else.

        **This has to be removed before any Play release.** Play restricts
        REQUEST_INSTALL_PACKAGES to apps whose core purpose is installing others, and Jawon's
        is not; on Play, Play does the updating and this is redundant anyway.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        For finding the music already on the phone, so adding a library is not a matter of
        handing over one folder at a time. Read-only, and audio only: Jawon never asks for
        photos, video, or "all files".

        Two permissions for one capability, because the platform split it. READ_MEDIA_AUDIO
        exists from API 33; below that the only way to read the user's audio is the blanket
        READ_EXTERNAL_STORAGE, so it is declared with a maxSdkVersion and simply not requested
        on newer phones. Both must be declared for the app to run from Android 9 to 16.

        The folder picker still works without either — SAF grants access to what the user
        points at, which is why the app has shipped this far with no storage permission at
        all. This is additive: decline it and nothing that worked before stops working.
    -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name=".JawonApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jawon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Jawon"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Where Spotify sends the user back after they sign in.

                Sign-in happens in the browser rather than in a WebView, which is not a style
                choice: a WebView is readable by the app hosting it, so a password typed into
                one has been handed over. The browser also already holds any Spotify session,
                which usually turns this into a single tap.

                This URI must match the redirect registered in the Spotify dashboard character
                for character. A trailing slash difference is reported as "INVALID_CLIENT:
                Invalid redirect URI", which does not hint that the two strings merely differ.
                See data/spotify/SpotifyAuth.REDIRECT_URI.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="jawon" android:host="spotify" />
            </intent-filter>
        </activity>

        <!--
            Hands a downloaded update to the system installer.

            An installer runs in another process and cannot read this app's private files, so
            the APK has to be passed as a content URI it is granted access to. Scoped to the
            updates cache directory alone — see res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>