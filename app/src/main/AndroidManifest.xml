<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        For the platter's haptics. A normal permission — granted at install, no prompt, and
        nothing to declare on Play's data safety form. See RoomHaptics for why the disc does
        not use View.performHapticFeedback: that route depends on the separate "touch
        feedback" system setting, which is off on many phones, and testers reported the disc
        had no vibration at all because of it.
    -->
    <!--
        For the equaliser. A normal permission — granted at install with no prompt — needed
        to attach an AudioEffect to the app's own playback session.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Cover art lookup, and nothing else. This is the app's only network use: an album
        title and an artist name go out for records whose own files carry no artwork, and an
        image comes back. No device id, no account, no library listing. It runs only when the
        user leaves the switch in Settings on, and the import screen says so before it happens.
        See data/importer/CoverArtFetcher.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        So Jawon can offer its own updates, instead of the owner sending an APK to everyone
        by hand every time something changes.

        This never installs anything silently, and cannot: the platform always shows its own
        install prompt, and the user has to have granted this app "install unknown apps"
        first. The real protection is the signing key — Android refuses an update signed with
        a different key than the installed app, so a tampered download can only fail, never
        replace Jawon with something else.

        **This has to be removed before any Play release.** Play restricts
        REQUEST_INSTALL_PACKAGES to apps whose core purpose is installing others, and Jawon's
        is not; on Play, Play does the updating and this is redundant anyway.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        For finding the music already on the phone, so adding a library is not a matter of
        handing over one folder at a time. Read-only, and audio only: Jawon never asks for
        photos, video, or "all files".

        Two permissions for one capability, because the platform split it. READ_MEDIA_AUDIO
        exists from API 33; below that the only way to read the user's audio is the blanket
        READ_EXTERNAL_STORAGE, so it is declared with a maxSdkVersion and simply not requested
        on newer phones. Both must be declared for the app to run from Android 9 to 16.

        The folder picker still works without either — SAF grants access to what the user
        points at, which is why the app has shipped this far with no storage permission at
        all. This is additive: decline it and nothing that worked before stops working.
    -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!--
        A USB CD drive, for ripping discs — see ui/cd/CdImportScreen.

        `required="false"` deliberately: almost no phone advertises USB host support in a way
        Play would filter on sensibly, and the overwhelming majority of this app's users will
        never attach a drive. Marking it required would remove Jawon from the store for devices
        that run every other part of it perfectly.

        No permission element: USB host access is granted per device, at runtime, by the system's
        own dialog. There is nothing to declare here for it.
    -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:name=".JawonApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jawon">
        <!--
            Profileable from the shell, in release builds too: what lets `atrace -a com.jawon.app`
            see the app's own trace sections and simpleperf sample it on the owner's phone, which
            only ever runs the release-signed build (ENGINEERING.md, trap 31). It grants nothing to
            other apps; it is the setting Google recommends for measuring a shipped build.
        -->
        <profileable android:shell="true" />
        <!--
            Portrait (0.7.3). The rooms are built for a phone held upright, and with nothing
            holding it a phone with auto-rotate on rebuilt the whole activity on a turn — every
            room, its engine and its art, for a layout no room was drawn for. The one thing a
            turn should do, the pocket player does itself: it reads the turn from gravity and
            draws sideways Cover Flow to meet it (SidewaysCoverFlow).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jawon"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                "Play <something> on Jawon." The assistant only offers an app that says it can be
                asked; the words arrive here when the phone itself is asked, and through the
                player's session when a car is. Both end in `LibrarySearch`.
            -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
                "Open with Jawon": a song, or an album as a ZIP - which is how a shop like
                Bandcamp delivers one. The music is copied into Music/Jawon and put on a shelf
                (`OpenedMusic`); nothing is read but what was handed over.

                `singleTask` above is for this: without it a file opened from a file manager
                would build a second Jawon - both rooms again - inside the file manager's task.
            -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/flac" />
                <data android:mimeType="application/x-flac" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="audio/*" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity>

        <!--
            Hands a downloaded update to the system installer.

            An installer runs in another process and cannot read this app's private files, so
            the APK has to be passed as a content URI it is granted access to. Scoped to the
            updates cache directory alone — see res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            The player. **Exported since 0.7.6**, because that is how a car, the assistant and the
            system's own media controls reach a player: they bind to this service, browse it and
            ask it to play. Exported means any app can try, so who is let in is decided in code -
            `SessionGate`: Jawon itself, a car, and what the phone already trusts with media.
        -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
            A "play" button reaching a Jawon that is closed - a headset's, a car's. Declared so the
            system can offer to resume the last record from its own media controls, and answers
            only if the owner has switched on Settings > Resume with headphones. See the class.
        -->
        <receiver
            android:name=".playback.ResumeButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
            A record's cover, for whoever is drawing what is playing - a car's screen, the lock
            screen. Read-only, one cover per album id, nothing to list. See the class for why it
            is exported and why that is all it can do.
        -->
        <provider
            android:name=".playback.CoverProvider"
            android:authorities="${applicationId}.covers"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!--
            The home-screen widget. Not exported: the system reaches it regardless, and its own
            buttons arrive as pending intents the app made - nothing else should be able to
            press play.
        -->
        <receiver
            android:name=".surfaces.RecordWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/record_widget" />
        </receiver>

        <!--
            Play and pause from Quick Settings. An *active* tile: the app tells the system when
            what it says has changed, instead of being woken each time the shade comes down.
        -->
        <service
            android:name=".surfaces.PlayerTile"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Android Auto: Jawon is a media app. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>

</manifest>