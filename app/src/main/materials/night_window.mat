// The pocket player's room: a train window at night, behind the device (NightWindow.kt).
//
// Everything outside is out of focus — the camera is focused on a device a hand's length away —
// so it is drawn as what a lens makes of it rather than as scenery that is then blurred: lights
// become discs, a pole going past becomes a soft dark sweep, the sky is a gradient. Doing the
// blur analytically is the whole trick: a depth-of-field pass cannot reach a circle of confusion
// this size (a quarter of the frame, for a 50mm lens focused at 30cm), and this costs a handful
// of discs per pixel.
//
// **Composed, not scattered (2026-10-02).** The first version spread its discs evenly over the
// whole window, sky included, and on a phone that read as a bokeh wallpaper — a dark object
// floating over polka dots — rather than a night outside a train. A player is looked *down* at,
// in the hands, so the window behind it shows the near ground across most of the picture and the
// horizon high up, in the strip above the device. So now there is a horizon there, with the
// distant towns along it as a fine glitter that comes and goes — towns, then open country — and
// their glow on the haze above; a navy sky, teal low down; fewer, larger lights below the
// horizon; and across the bottom strip the window's own sill, warm where the reading lamp catches
// it. Cool outside, warm inside, and the device between them.
//
// Three layers of lights at three depths, each scrolled by its own distance (the room integrates
// the train's drifting speed on the CPU and hands the offsets in, so nothing here depends on a
// clock that loses precision), a sparse row of poles in the foreground, the sky and the land,
// and the sill — the one thing in the picture that does not move, because it is the carriage.
//
// **Each term is evaluated only on the rows that can see it**: a band of lights returns at once
// outside its own reach, the sky's haze only above the land, the sill's texture only on the sill.
// Most of this plane is behind the device, and what is not is mostly dark.
//
// Unlit: it is a picture of light, and nothing in the carriage should darken it.
//
// Compiled by hand with a version-matched matc. See docs/materials.md.

material {
    name : NightWindow,
    requires : [
        uv0
    ],
    shadingModel : unlit,
    blending : opaque,
    parameters : [
        {
            // The plane's size in metres, so a disc is round and a cell is the same size
            // wherever the plane is stretched to.
            type : float2,
            name : size
        },
        {
            // How far each layer has travelled, in metres of plane: far, mid, near lights, poles.
            type : float4,
            name : scroll,
            precision : high
        },
        {
            // The train's bob, in metres of plane: x across, y up.
            type : float2,
            name : bob
        },
        {
            // Overall brightness of the outside, so the room can dim it without a rebuild.
            type : float,
            name : gain
        }
    ]
}

fragment {
    highp float hash11(highp float p) {
        p = fract(p * 0.1031);
        p *= p + 33.33;
        p *= p + p;
        return fract(p);
    }

    highp float hash12(highp vec2 p) {
        highp vec3 p3 = fract(vec3(p.xyx) * 0.1031);
        p3 += dot(p3, p3.yzx + 33.33);
        return fract((p3.x + p3.y) * p3.z);
    }

    highp vec2 hash22(highp vec2 p) {
        highp vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
        p3 += dot(p3, p3.yzx + 33.33);
        return fract((p3.xx + p3.yz) * p3.zy);
    }

    // Cells repeat every PERIOD columns, and the room wraps each layer's scroll at exactly that
    // many cells — so the scroll never grows large enough to lose precision, and the wrap is
    // seamless. At the speeds the room uses the pattern comes round again after 12 minutes for
    // the nearest layer and nearly two hours for the farthest.
    const highp float PERIOD = 4096.0;

    // The horizon and the sill, in metres of plane from its centre, up positive. The plane is
    // 0.55m behind a device 0.33m from the eye, so the device covers about +-0.14m of it: the
    // horizon sits in the strip above the device, the sill in the strip below.
    const float HORIZON = 0.170;
    const float SILL_Y = -0.178;

    // What a light out there is. [near] leans the choice from a town's warm windows toward the
    // sodium and LED of the lineside, and now and then a signal.
    vec3 palette(float k, float near) {
        if (k < 0.40 + 0.15 * near) return vec3(1.00, 0.40, 0.09);   // sodium
        if (k < 0.78) return vec3(1.00, 0.68, 0.36);                  // warm window, tungsten
        if (k < 0.955) return vec3(0.60, 0.78, 1.00);                 // LED, cold
        if (k < 0.985) return vec3(1.00, 0.12, 0.08);                 // a red signal
        return vec3(0.20, 1.00, 0.50);                                // a green one
    }

    // Where the towns are along the line: smooth 1-D noise over a layer's cell index, periodic
    // at PERIOD so it wraps with the scroll (cellsPerTown must divide PERIOD). 0 is open
    // country, 1 the middle of a town.
    float towns(highp float cell, highp float cellsPerTown, float seed) {
        highp float x = cell / cellsPerTown;
        highp float i = floor(x);
        float f = float(x - i);
        highp float n = PERIOD / cellsPerTown;
        float a = hash11(mod(i, n) * 1.37 + seed);
        float b = hash11(mod(i + 1.0, n) * 1.37 + seed);
        float t = f * f * (3.0 - 2.0 * f);
        return smoothstep(0.30, 0.85, mix(a, b, t));
    }

    // Smooth 2-D value noise, for the haze, the land's edge, the grime and the sill's wear.
    float noise2(highp vec2 p) {
        highp vec2 i = floor(p);
        vec2 f = vec2(p - i);
        vec2 u = f * f * (3.0 - 2.0 * f);
        float a = hash12(i);
        float b = hash12(i + vec2(1.0, 0.0));
        float c = hash12(i + vec2(0.0, 1.0));
        float d = hash12(i + vec2(1.0, 1.0));
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
    }

    float fbm(highp vec2 p) {
        float v = 0.0;
        float a = 0.5;
        for (int i = 0; i < 4; i++) {
            v += a * noise2(p);
            p = p * 2.03 + vec2(17.1, 9.3);
            a *= 0.5;
        }
        return v;
    }

    // One depth's worth of lights, in a band of the picture between y0 and y1. A cell may hold
    // up to eight — the far towns need that many to glitter — so the cell *width*, and with it
    // the room's scroll wrap, stays what NightWindow says it is. A disc never reaches past one
    // neighbour, so three cells answer; outside the band's reach nothing is asked at all.
    //
    // Each light is a disc with a soft edge and the slightly brighter rim a real lens gives a
    // defocused point. [glass] is the grime on the window at this pixel: it does not move, so a
    // disc sliding past carries the dirt of each bit of glass it crosses, as a real one does.
    vec3 lights(highp vec2 p, highp float scroll, highp float cellW, float y0, float y1,
                float radius, float density, float perCell, highp float cellsPerTown, float seed,
                float bright, float near, float glass) {
        float reach = radius * 1.4;
        if (float(p.y) < y0 - reach || float(p.y) > y1 + reach) return vec3(0.0);
        highp float x = p.x + scroll;
        highp float id = floor(x / cellW);
        highp float local = x - id * cellW;
        vec3 acc = vec3(0.0);
        for (int i = -1; i <= 1; i++) {
            highp float cid = mod(id + float(i), PERIOD);
            float here = density * mix(0.10, 1.0, towns(cid, cellsPerTown, seed));
            for (int k = 0; k < 8; k++) {
                if (float(k) >= perCell) break;
                highp vec2 key = vec2(cid, float(k) * 7.0 + seed);
                if (hash12(key) >= here) continue;
                highp vec2 r = hash22(key * 1.37);
                float rad = radius * (0.72 + 0.56 * hash12(key + 3.3));
                // Lower in the band is nearer, and nearer is a little larger.
                float y = mix(y0, y1, r.y);
                rad *= mix(1.12, 0.90, r.y);
                vec2 centre = vec2((float(i) + r.x) * float(cellW), y);
                float d = length(vec2(float(local), float(p.y)) - centre);
                float edge = rad * 0.20;
                float disc = 1.0 - smoothstep(rad - edge, rad + edge, d);
                float rim = smoothstep(rad * 0.55, rad, d) * disc;
                float power = mix(0.22, 1.0, pow(hash12(key + 9.1), 2.2));
                // A little flicker on some — a lamp seen through trees, a sign.
                float flick = hash12(key + 2.9) < 0.12
                    ? 0.78 + 0.22 * sin(float(scroll) * 41.0 + r.y * 40.0)
                    : 1.0;
                acc += palette(hash12(key + 5.7), near) * power * flick * (disc * 0.80 + rim * 0.22);
            }
        }
        return acc * bright * glass;
    }

    // Poles and trees in the foreground: soft dark sweeps across everything behind them.
    float poles(highp float x, highp float scroll) {
        highp float px = x + scroll;
        highp float cell = 0.95;
        highp float id = floor(px / cell);
        float shade = 0.0;
        for (int i = -1; i <= 1; i++) {
            highp float cid = mod(id + float(i), PERIOD);
            if (hash11(cid * 7.13 + 1.7) < 0.42) {
                float centre = (float(i) + 0.2 + 0.6 * hash11(cid * 3.31 + 4.2)) * cell;
                float width = 0.035 + 0.05 * hash11(cid * 1.91 + 8.8);
                float d = abs(float(px - id * cell) - centre);
                shade = max(shade, 1.0 - smoothstep(width * 0.3, width * 1.9, d));
            }
        }
        return shade;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 size = materialParams.size;
        // Metres on the plane, centred, up positive. **SceneView's PlaneNode runs V downward**:
        // read straight, the first build hung the sky under the device and the carriage's
        // reflection along the bottom, which the luminance boxes caught before the eye did.
        highp vec2 uv = getUV0();
        highp vec2 p = vec2(uv.x - 0.5, 0.5 - uv.y) * size;
        highp vec4 scroll = materialParams.scroll;
        vec2 bob = materialParams.bob;
        highp vec2 q = p + bob;
        float y = float(q.y);
        float above = y - HORIZON;

        // ---- the land, and the sky over it -------------------------------------------------
        // Where the towns are, at the far layer's pace: the glow on the haze follows them.
        float glow = 0.0;
        if (above > -0.05) {
            glow = towns((q.x + scroll.x) / 0.050, 16.0, 11.0);
        }
        float ridge = HORIZON - 0.003 + 0.007 * (noise2(vec2(float(q.x + scroll.y) * 5.0, 3.7)) - 0.5);
        float land = smoothstep(ridge + 0.005, ridge - 0.005, y);
        vec3 colour = vec3(0.0024, 0.0026, 0.0033) + vec3(0.010, 0.005, 0.0018) * glow * exp(-max(-above, 0.0) / 0.012);
        if (land < 1.0) {
            // Navy overhead, a cooler teal low down; haze, very far and very slow, lit warm from
            // below where a town is.
            float t = clamp(above / 0.075, 0.0, 1.0);
            vec3 sky = mix(vec3(0.020, 0.030, 0.048), vec3(0.0030, 0.0045, 0.0100), pow(t, 0.45));
            float haze = fbm(vec2(float(q.x + scroll.x * 0.35) * 7.0, y * 30.0));
            sky *= 0.78 + 0.44 * haze;
            float lift = exp(-max(above, 0.0) / 0.026);
            sky += vec3(0.105, 0.050, 0.017) * glow * lift * (0.65 + 0.7 * haze);
            colour = mix(sky, colour, land);
        }

        // ---- the lights, far to near: a town's worth on the horizon, fewer lower down, and
        // now and then a lineside lamp near enough to be large ------------------------------
        float py = float(p.y);
        if (above > -0.06 || (py > -0.21 && py < -0.09)) {
            // Grime on the glass, fixed to the window — see [lights].
            float grime = 0.86 + 0.30 * fbm(vec2(p) * 34.0);
            // Densities and sizes tuned against a full-frame preview of the phone (window
            // shader in WebGL, device in Cycles, Filament's grade): the far band glitters in a
            // town and thins to a few points in open country; the near lamps are rare.
            colour += lights(q, scroll.x, 0.050, HORIZON - 0.011, HORIZON + 0.0020, 0.0036,
                             1.0, 8.0, 16.0, 11.0, 1.55, 0.0, grime);
            colour += lights(q, scroll.y, 0.072, HORIZON - 0.040, HORIZON - 0.012, 0.0085,
                             0.45, 2.0, 16.0, 23.0, 1.10, 0.4, grime);
            colour += lights(q, scroll.z, 0.110, -0.175, -0.120, 0.0185,
                             0.26, 1.0, 16.0, 37.0, 1.00, 1.0, grime);
        }

        // ---- the foreground going past ------------------------------------------------------
        colour *= 1.0 - 0.85 * poles(float(q.x), scroll.w);

        // ---- the window's sill, across the bottom: the carriage, which does not move -------
        // As out of focus as everything else on this plane. Its rounded top edge catches the
        // reading lamp warm — brightest under the lamp, which hangs up and to the left — its
        // face falls away darker below, and a dark seal runs where it meets the glass. Fixed to
        // [p], not [q]: it is the carriage, and the carriage is what you are sitting in.
        // Gaussians use Filament's own sq(), **not pow(x, 2.0)**: GLSL leaves pow undefined
        // for a negative base, and a gaussian's argument is negative on one side of its peak.
        if (py < SILL_Y + 0.012) {
            float sill = smoothstep(SILL_Y + 0.0045, SILL_Y - 0.0045, py);
            float seal = exp(-sq((py - SILL_Y - 0.0015) / 0.0035));
            float edgeLit = exp(-sq((py - SILL_Y + 0.0060) / 0.0075));
            float face = smoothstep(SILL_Y, SILL_Y - 0.040, py);
            float px = float(p.x);
            float nearLamp = 0.35 + 0.65 * exp(-sq((px + 0.07) / 0.13));
            float wear = 0.80 + 0.40 * fbm(vec2(px * 40.0, py * 90.0));
            vec3 sillColour = vec3(0.020, 0.014, 0.0095) * (1.0 - 0.55 * face) * (0.7 + 0.3 * nearLamp)
                + vec3(0.120, 0.078, 0.043) * edgeLit * nearLamp * wear;
            colour = mix(colour * (1.0 - 0.6 * seal), sillColour, sill);
        }

        material.baseColor = vec4(colour * materialParams.gain, 1.0);
    }
}
