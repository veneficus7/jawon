// The CD's surface: a printed label under a diffraction rainbow.
//
// Ported from the prototype's disc shader (javon-shelf-prototype.html, the DFS
// fragment source) onto Filament's `lit` shading model. The prototype was a bare
// ShaderMaterial with no PBR underneath, so it had to compute its own specular, rim
// and fog terms; those are dropped here. Filament's lit model already does specular
// from metallic/roughness, and rim light and fog belong to M9 — keeping the
// prototype's versions would double up and then fight M9's.
//
// Compiled by hand with a version-matched matc. See docs/materials.md.

material {
    name : DiscIridescent,
    requires : [
        uv0
    ],
    shadingModel : lit,
    parameters : [
        {
            type : sampler2d,
            name : face
        },
        {
            // Strength of the diffraction rainbow. Prototype's exported IRIDESCENCE.
            type : float,
            name : iridescence
        },
        {
            // Spatial frequency of the grating — how many colour bands from the
            // centre hole out to the rim. Prototype's exported GRATING.
            type : float,
            name : grating
        }
    ],
}

fragment {
    vec3 hsv2rgb(vec3 c) {
        vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
        vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
        return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = getUV0();

        // Polar coordinates come free from the geometry. DiscGeometry writes
        // uv = (cos0 * r/R * 0.5 + 0.5, sin0 * r/R * 0.5 + 0.5), so mapping the UV
        // back to [-1,1] gives a vector whose length is r/R and whose angle is the
        // angle round the disc — no custom varyings, no extra vertex data.
        vec2 p = uv * 2.0 - 1.0;
        float r = length(p);

        // The printed face: label art, clamping ring and plastic, all baked by
        // DiscArt. The centre hole and the square's corners are holes in the mesh
        // rather than alpha, so this material is opaque.
        material.baseColor = texture(materialParams_face, uv);
        material.metallic = 0.72;
        material.roughness = 0.22;

        vec3 V = getWorldViewVector();

        // A real CD's colours come from its track pitch acting as a diffraction
        // grating: the hue you see depends on how far out you are and on the angle
        // you view it from. Hence radius and view direction driving the phase.
        //
        // The prototype adds an `atan(p.y, p.x) * 0.6` term as well. That is dropped:
        // a CD's grating is a circle, so it is rotationally symmetric and has no
        // angular term physically — and atan2's wrap at +/-PI left a hard seam running
        // out to the rim, which is very visible once the disc fills the frame.
        float g = r * materialParams.grating
                + dot(V, vec3(1.0, 0.7, 0.2)) * 11.0;

        // Saturation well below the prototype's 0.92. This is a sheen lying over the
        // printed label, not a replacement for it — at full purity the disc reads as a
        // rainbow lollipop and the artwork disappears completely underneath.
        vec3 rain = hsv2rgb(vec3(fract(g * 0.055), 0.55, 1.0));

        // The prototype weights this by Fresnel, and that does NOT port: its disc is a
        // lathe with a curved, bevelled rim, so its normals vary and Fresnel varies with
        // them. DiscGeometry is a flat annulus — every normal is +Z. A 120mm disc viewed
        // from 0.55m spans dot(N,V) of 1.0 down to 0.994, so pow(1 - |N.V|, 2.4) is about
        // 4e-6 across the whole face and multiplies the rainbow away to nothing.
        //
        // Radius is the honest substitute. On a real CD the printed label is opaque and
        // it is the bare outer plastic that flares, so the colour ramps in past the
        // clamping ring and strengthens toward the rim.
        float band = smoothstep(0.30, 0.72, r);

        // emissive is rgb + an alpha that is the *exposure weight*. Zero keeps the
        // room's exposure from washing the rainbow out.
        material.emissive = vec4(rain * band * materialParams.iridescence, 0.0);
    }
}
