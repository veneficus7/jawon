// The printed plates of every case — cover, spine and back — and of the case held open:
// SceneView's `opaque_textured`, line for line, with the shelf-edge rail's light added.
//
// **Why it is hand-written.** The rail was four rows of 15 spotlights, there only to light these
// plates, and lights were what made a frame of the wall expensive (ENGINEERING.md, trap 46). A
// plate moves — a case floats, turns, is pulled out and opened — so its light cannot be baked
// onto it. What never moves is the light in the space in front of the rack, and `RailLight`
// computes that once: at every point, the sum of each head's illuminance times the direction it
// arrives from, apart by azimuth in six bins of 30° (three stored, to the point's +x; the other
// three are their mirror). A surface with normal n receives Σ max(n·Vᵦ, 0), exact wherever all the
// heads of a bin are in front of it and within about 1.5% for a case turned anywhere. Each bin is
// then shaded with Filament's own model for a light from its direction: Lambert, GGX,
// height-correlated Smith, Schlick. The result is multiplied by the camera's exposure here, in highp, as Filament
// pre-exposes its lights, and goes out as emissive with an exposure weight of 0
// (`surface_shading_lit.fs`, 1.72.1).
//
// The plates stay on the channel the rail was on, so the held case's own lights still reach
// them; nothing else lit them.
//
// Compiled by hand with a version-matched matc. See docs/materials.md.

material {
    name : Plate,
    shadingModel : lit,
    blending : opaque,
    requires : [ uv0 ],
    parameters : [
        {
            // The plate's printed art, sRGB, as `opaque_textured` takes it.
            type : sampler2d,
            name : texture
        },
        {
            type : float,
            name : metallic
        },
        {
            type : float,
            name : roughness
        },
        {
            type : float,
            name : reflectance
        },
        {
            // RailLight's tables, one per stored bin: Vᵦ by how far behind the rail (across) and
            // below its line (down).
            type : sampler2d,
            name : rail0,
            precision : high
        },
        {
            type : sampler2d,
            name : rail1,
            precision : high
        },
        {
            type : sampler2d,
            name : rail2,
            precision : high
        },
        {
            // The rail's colour, linear, as its heads had it; times the bench gain.
            type : float3,
            name : railColor
        },
        {
            // Lux per unit of the table (RailLight.LUX_PER_UNIT). 0 switches the light off.
            type : float,
            name : railLux
        },
        {
            // World height of the top row's rail; every other row's is a pitch below it.
            type : float,
            name : railTopY
        },
        {
            type : float,
            name : railPitch
        },
        {
            // How many rows the rack has, so there is no rail below the bottom one.
            type : float,
            name : railRows
        },
        {
            // World z of the rail.
            type : float,
            name : railZ
        },
        {
            // The table's span behind the rail (RailLight.Z_NEAR, Z_FAR) and below it (D_MAX).
            type : float,
            name : railNear
        },
        {
            type : float,
            name : railFar
        },
        {
            type : float,
            name : railReach
        },
        {
            // 1 paints the plate magenta, to find its pixels in a screenshot.
            type : float,
            name : mask
        }
    ]
}

fragment {
    float plateD(float a, float NoH) {
        float a2 = a * a;
        float f = (NoH * a2 - NoH) * NoH + 1.0;
        return a2 / (PI * f * f);
    }

    float plateV(float a, float NoV, float NoL) {
        float a2 = a * a;
        float lambdaV = NoL * sqrt((NoV - a2 * NoV) * NoV + a2);
        float lambdaL = NoV * sqrt((NoL - a2 * NoL) * NoL + a2);
        return 0.5 / (lambdaV + lambdaL);
    }

    vec3 plateF(vec3 f0, float VoH) {
        float f = pow(1.0 - VoH, 5.0);
        return f + f0 * (1.0 - f);
    }

    // What one bin of the rail sends towards the eye: its irradiance vector V, in lux.
    highp vec3 railRadiance(vec3 diffuse, vec3 f0, float a, vec3 n, vec3 v, highp vec3 V) {
        highp float E = dot(n, V);
        if (E <= 0.0) {
            return vec3(0.0);
        }
        vec3 l = normalize(V);
        vec3 h = normalize(v + l);
        float NoV = max(dot(n, v), 1e-4);
        float NoL = clamp(dot(n, l), 0.0, 1.0);
        float NoH = clamp(dot(n, h), 0.0, 1.0);
        float LoH = clamp(dot(l, h), 0.0, 1.0);
        vec3 specular = plateD(a, NoH) * plateV(a, NoV, NoL) * plateF(f0, LoH);
        return (diffuse * (1.0 / PI) + specular) * E;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 base = texture(materialParams_texture, getUV0());
        material.baseColor = base;
        material.metallic = materialParams.metallic;
        material.roughness = materialParams.roughness;
        material.reflectance = materialParams.reflectance;

        if (materialParams.mask > 0.5) {
            material.baseColor = vec4(1.0, 0.0, 1.0, 1.0);
            material.emissive = vec4(0.6, 0.0, 0.6, 0.0);
            return;
        }
        if (materialParams.railLux <= 0.0) {
            return;
        }

        // Highp throughout the geometry and the light: right under a head the light runs to
        // hundreds of thousands of lux, past what a 16-bit float holds.
        highp vec3 p = getUserWorldPosition();
        highp float behind = materialParams.railZ - p.z;
        highp float across = (behind - materialParams.railNear) /
                (materialParams.railFar - materialParams.railNear);
        if (across < 0.0 || across > 1.0) {
            return;
        }
        highp float pitch = materialParams.railPitch;
        highp float below = materialParams.railTopY - p.y;
        highp float row = floor(below / pitch);    // the rail just above this point
        highp float d = below - row * pitch;       // how far below it, 0..pitch
        highp vec3 V0 = vec3(0.0);
        highp vec3 V1 = vec3(0.0);
        highp vec3 V2 = vec3(0.0);
        // This row's rail, and the one above it, which lights through the board as Filament's
        // lights did (they cast no shadow). Nothing above the top rail or below the bottom one.
        if (row >= 0.0 && row < materialParams.railRows) {
            highp vec2 uv = vec2(across, d / materialParams.railReach);
            V0 += texture(materialParams_rail0, uv).rgb;
            V1 += texture(materialParams_rail1, uv).rgb;
            V2 += texture(materialParams_rail2, uv).rgb;
        }
        if (row >= 1.0 && row - 1.0 < materialParams.railRows && d + pitch < materialParams.railReach) {
            highp vec2 uv = vec2(across, (d + pitch) / materialParams.railReach);
            V0 += texture(materialParams_rail0, uv).rgb;
            V1 += texture(materialParams_rail1, uv).rgb;
            V2 += texture(materialParams_rail2, uv).rgb;
        }
        V0 *= materialParams.railLux;
        V1 *= materialParams.railLux;
        V2 *= materialParams.railLux;

        float a = materialParams.roughness * materialParams.roughness;
        vec3 diffuse = base.rgb * (1.0 - materialParams.metallic);
        vec3 f0 = mix(vec3(0.16 * materialParams.reflectance * materialParams.reflectance),
                      base.rgb, materialParams.metallic);
        vec3 n = getWorldNormalVector();
        vec3 v = getWorldViewVector();
        // Each stored bin, and its mirror to the point's −x.
        highp vec3 radiance = railRadiance(diffuse, f0, a, n, v, V0)
                + railRadiance(diffuse, f0, a, n, v, vec3(-V0.x, V0.y, V0.z))
                + railRadiance(diffuse, f0, a, n, v, V1)
                + railRadiance(diffuse, f0, a, n, v, vec3(-V1.x, V1.y, V1.z))
                + railRadiance(diffuse, f0, a, n, v, V2)
                + railRadiance(diffuse, f0, a, n, v, vec3(-V2.x, V2.y, V2.z));
        // Exposed here, in highp, and handed over with an exposure weight of 0. Unexposed this is
        // tens of thousands of nits on a cover, and a phone's GPU may keep `material.emissive`
        // at mediump, which a desktop GPU never shows.
        material.emissive = vec4(materialParams.railColor * radiance * getExposure(), 0.0);
    }
}
